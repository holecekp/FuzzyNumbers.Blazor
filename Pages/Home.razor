@page "/"
@using Holecek.FuzzyMath.FuzzyNumbers
@using FuzzyNumbers.Blazor.Interfaces

<PageTitle>Fuzzy numbers arithmetic</PageTitle>

<h1>Fuzzy numbers parsing and drawing demo</h1>

A = <input type="text" @bind="FuzzyNumberString" />
<button @onclick="TestFuzzyNumerParsingAndFormatting">
    Update
</button>

<p>
    @message
</p>

<div style="width: 800px;">
    <canvas id="fuzzyGraph"></canvas>
</div>

<hr />

<p>
    The <a href="https://github.com/holecekp/FuzzyNumbers.Blazor">source code for this page</a> is available on GitHub. The page demonstrate the usage
    of a free <a href="https://github.com/holecekp/FuzzyMath">open-source library FuzzyMath</a> by Pavel Holeček. You can get the library
    as a <a href="https://www.nuget.org/packages/Holecek.FuzzyMath">NuGet package</a>, so that you can use it in your .NET projects.
</p>

@code {
    @inject IJSRuntime _jsRuntime
    @inject IFuzzyNumberParser _fuzzyNumberParser
    @inject IFuzzyNumberFormatter _fuzzyNumberFormatter
    @inject IFuzzyNumberToGraphPointsConverter _fuzzyNumberToGraphPointsConverter

    string FuzzyNumberString { get; set; } = "1, 2, 3";
    string message = "";
    bool graphInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await TestFuzzyNumerParsingAndFormatting();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task TestFuzzyNumerParsingAndFormatting()
    {
        if (_fuzzyNumberParser.TryParse(FuzzyNumberString, out FuzzyNumber? parsedFuzzyNumber))
        {
            string formattedFuzzyNumber = _fuzzyNumberFormatter.Format(parsedFuzzyNumber);           
            var points = _fuzzyNumberToGraphPointsConverter.Convert(parsedFuzzyNumber);

            message = $"The entered fuzzy number is {formattedFuzzyNumber}.";
            StateHasChanged();

            if (!graphInitialized)
            {
                await _jsRuntime.InvokeVoidAsync("window.drawGraph", points);
                graphInitialized = true;
            }
            else
            {
                await _jsRuntime.InvokeVoidAsync("window.updateGraphData", points);
            }
        }
        else
        {
            message = $"The entered fuzzy number is not valid.";
        }
    }
}
