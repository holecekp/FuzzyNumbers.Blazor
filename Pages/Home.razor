@page "/"
@using System.ComponentModel.DataAnnotations 
@using Holecek.FuzzyMath.FuzzyNumbers
@using FuzzyNumbers.Blazor.Controls
@using FuzzyNumbers.Blazor.Interfaces
@using FuzzyNumbers.Blazor.Models

<PageTitle>Arithmetic operations on fuzzy numbers</PageTitle>

<header>
    <h1>Arithmetic operations on fuzzy numbers</h1>
    <div class="header-icons">
        <a href="https://github.com/holecekp/FuzzyNumbers.Blazor" title="Source code for this page on GitHub"><i class="fab fa-github"></i></a>
        <a href="https://www.nuget.org/packages/Holecek.FuzzyMath" title="Download NuGet for the FuzzyMath library to use it in your .NET projects"><i class="fas fa-box"></i></a>
    </div>
</header>

<main>
    <div class="card">

        <!-- LEFT: FORM -->
        <div class="card-left">
            <h2>Enter Fuzzy Numbers</h2>

            <EditForm Model="Model" OnValidSubmit="RecalculateResult" FormName="FuzzyNumberForm">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="fuzzyNumberA">Fuzzy number A</label>
                    <InputFuzzyNumber id="fuzzyNumberA" @bind-Value="Model.FirstFuzzyNumber" DisplayName="Fuzzy number A" />
                </div>
                <ValidationMessage For="@(() => Model.FirstFuzzyNumber)" />


                <div class="form-group">
                    <label for="fuzzyNumberB">Fuzzy number B</label>
                    <InputFuzzyNumber id="fuzzyNumberB" @bind-Value="Model.SecondFuzzyNumber" DisplayName="Fuzzy number B" />
                </div>
                <ValidationMessage For="@(() => Model.SecondFuzzyNumber)" />

                <div class="form-group">
                    <label for="operation">Operation</label>
                    <InputSelect id="operation" @bind-Value="Model.ArithmeticOperation">
                        <option value="@(nameof(ArithmeticOperation.Addition))">Addition A+B</option>
                        <option value="@(nameof(ArithmeticOperation.Subtraction))">Subtraction A-B</option>
                        <option value="@(nameof(ArithmeticOperation.Multiplication))">Multiplication A⋅B</option>
                        <option value="@(nameof(ArithmeticOperation.Division))">Division A/B</option>
                    </InputSelect>
                </div>

                <button type="submit">Calculate the result and update the graph</button>
            </EditForm>
        </div>

        <!-- RIGHT: INFO -->
        <div class="card-right">
            <h3>How to use</h3>

            <p>
                This page performs arithmetic operations on two fuzzy numbers using the open-source FuzzyMath library by Pavel Holeček.
                For more information, see the links at the bottom of the page for the source code of this site and the FuzzyMath library.
            </p>

        </div>
    </div>

    @* <p>
        @message
    </p> *@

    <div class="graph">
        <canvas id="fuzzyGraph"></canvas>
    </div>

</main>


<footer>
    <p>
        The <a href="https://github.com/holecekp/FuzzyNumbers.Blazor">source code for this page</a> is available on GitHub.
        It demonstrates how to use the free, open-source <a href="https://github.com/holecekp/FuzzyMath">FuzzyMath library</a> by Pavel Holeček.
        The library is available as a <a href="https://www.nuget.org/packages/Holecek.FuzzyMath">NuGet package</a> for use in your .NET projects.
    </p>

    <p>
        © 2026 Pavel Holeček
    </p>
</footer>

@code {
    @inject IJSRuntime _jsRuntime
    @inject IFuzzyNumberParser _fuzzyNumberParser
    @inject IFuzzyNumberFormatter _fuzzyNumberFormatter
    @inject IFuzzyNumberToGraphPointsConverter _fuzzyNumberToGraphPointsConverter


    [SupplyParameterFromForm]
    FuzzyArithmeticsFormModel Model { get; set;}= new();

    string message = "";
    bool graphInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RecalculateResult();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task RecalculateResult()
    {
        string formattedFirstFuzzyNumber = _fuzzyNumberFormatter.Format(Model.FirstFuzzyNumber);
        var firstFuzzyNumberPoints = _fuzzyNumberToGraphPointsConverter.Convert(Model.FirstFuzzyNumber);

        string formattedSecondFuzzyNumber = _fuzzyNumberFormatter.Format(Model.SecondFuzzyNumber);
        var secondFuzzyNumberPoints = _fuzzyNumberToGraphPointsConverter.Convert(Model.SecondFuzzyNumber);

        Func<FuzzyNumber, FuzzyNumber, int, FuzzyNumber> arithmeticOperationFunc = Model.ArithmeticOperation switch
        {
            ArithmeticOperation.Addition => FuzzyNumberArithmetic.Add,
            ArithmeticOperation.Subtraction => FuzzyNumberArithmetic.Subtract,
            ArithmeticOperation.Multiplication => FuzzyNumberArithmetic.Multiply,
            ArithmeticOperation.Division => FuzzyNumberArithmetic.Divide,
            _ => throw new InvalidOperationException("Unsupported arithmetic operation")
        };

        const int alphaCutsCount = 100;
        FuzzyNumber result = arithmeticOperationFunc(Model.FirstFuzzyNumber, Model.SecondFuzzyNumber, alphaCutsCount);
        var resultPoints = _fuzzyNumberToGraphPointsConverter.Convert(result);

        message = $"The result for the entered fuzzy numbers ({formattedFirstFuzzyNumber}) {Model.ArithmeticOperationSign} ({formattedSecondFuzzyNumber}):";

        string resultLabel = Model.ArithmeticOperationFormula;
        if (!graphInitialized)
        {
            await _jsRuntime.InvokeVoidAsync(
                "window.drawGraph",
                firstFuzzyNumberPoints,
                secondFuzzyNumberPoints,
                resultPoints,
                resultLabel);

            graphInitialized = true;
        }
        else
        {
            await _jsRuntime.InvokeVoidAsync(
                "window.updateGraphData",
                firstFuzzyNumberPoints,
                secondFuzzyNumberPoints,
                resultPoints,
                resultLabel);
        }

        StateHasChanged();
    }
}
